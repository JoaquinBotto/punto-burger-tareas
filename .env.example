VITE_SUPABASE_URL=https://tu-proyecto.supabase.co/

# Clave pública / Publishable Key de Supabase (Publishable Key / Public API Key)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui

# URL de la aplicación web (para redirecciones de Auth)
